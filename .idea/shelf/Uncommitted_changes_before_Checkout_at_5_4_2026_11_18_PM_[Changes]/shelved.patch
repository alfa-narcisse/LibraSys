Class=\"stat-title\"/>\r\n                    <Label fx:id=\"todayLoansLabel\" text=\"0\" styleClass=\"stat-value\"/>\r\n                    <Label fx:id=\"todayReturnsLabel\" text=\"0 retour\" styleClass=\"stat-sub\"/>\r\n                </VBox>\r\n                <VBox HBox.hgrow=\"ALWAYS\" styleClass=\"stat-card\">\r\n                    <Label text=\"Retards\" styleClass=\"stat-title\"/>\r\n                    <Label fx:id=\"todayDelaysLabel\" text=\"0\" styleClass=\"stat-value\"/>\r\n                    <Label text=\"A triter\" styleClass=\"stat-sub\"/>\r\n                </VBox>\r\n            </HBox>\r\n\r\n            <HBox spacing=\"12\" VBox.vgrow=\"ALWAYS\">\r\n                <VBox HBox.hgrow=\"ALWAYS\" styleClass=\"panel-card\" spacing=\"10\">\r\n                    <Label text=\"Activite mensuelle (prets)\" styleClass=\"panel-title\"/>\r\n                    <BarChart fx:id=\"monthlyActivityChart\" categoryGap=\"24\" barGap=\"6\" styleClass=\"activity-chart\" VBox.vgrow=\"ALWAYS\">\r\n                        <xAxis>\r\n                            <CategoryAxis/>\r\n                        </xAxis>\r\n                        <yAxis>\r\n                            <NumberAxis/>\r\n                        </yAxis>\r\n                    </BarChart>\r\n                </VBox>\r\n\r\n                <VBox prefWidth=\"300\" styleClass=\"panel-card\" spacing=\"12\">\r\n                    <Label text=\"Livres populaires\" styleClass=\"panel-title\"/>\r\n\r\n                    <VBox fx:id=\"popularBooksContainer\" spacing=\"6\">\r\n                    </VBox>\r\n\r\n                </VBox>\r\n            </HBox>\r\n\r\n            <VBox spacing=\"8\" styleClass=\"panel-card loans-card\">\r\n                <Label text=\"Prets recents\" styleClass=\"panel-title\"/>\r\n                <TableView fx:id=\"recentLoansTable\">\r\n                    <columns>\r\n                        <TableColumn fx:id=\"studentColumn\" text=\"Etudiant\" prefWidth=\"220\"/>\r\n  