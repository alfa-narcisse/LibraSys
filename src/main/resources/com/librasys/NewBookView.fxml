<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="newBookRoot"
      fx:controller="com.librasys.controller.NewBookController"
      styleClass="new-book-root" spacing="16">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox alignment="CENTER_LEFT" styleClass="new-book-header">
        <Button text="← Retour à la liste" onAction="#onBackToList" styleClass="back-link-btn"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Nouveau Livre" styleClass="new-book-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <GridPane hgap="16" vgap="12" VBox.vgrow="ALWAYS" styleClass="new-book-grid">
        <columnConstraints>
            <ColumnConstraints percentWidth="58"/>
            <ColumnConstraints percentWidth="42"/>
        </columnConstraints>

        <VBox spacing="10" GridPane.columnIndex="0" styleClass="new-book-section">
            <VBox spacing="5">
                <Label text="ISBN" styleClass="form-label"/>
                <HBox spacing="8">
                    <TextField fx:id="isbnField" promptText="978-..." HBox.hgrow="ALWAYS" styleClass="form-input"/>
                    <Button text="Scanner" styleClass="books-secondary-btn"/>
                </HBox>
            </VBox>

            <VBox spacing="5">
                <Label text="Titre" styleClass="form-label"/>
                <TextField fx:id="titleField" promptText="Titre du livre" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Auteur(s)" styleClass="form-label"/>
                <TextField fx:id="authorField" promptText="Nom de l'auteur (suggestions...)" styleClass="form-input"/>
            </VBox>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Année d'édition" styleClass="form-label"/>
                    <TextField fx:id="yearField" promptText="2026" styleClass="form-input"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Éditeur" styleClass="form-label"/>
                    <TextField fx:id="publisherField" promptText="Nom de l'éditeur" styleClass="form-input"/>
                </VBox>
            </HBox>

            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="Description / Résumé" styleClass="form-label"/>
                <TextArea fx:id="summaryArea" prefRowCount="3" wrapText="true" styleClass="form-input form-area"/>
            </VBox>
        </VBox>

        <VBox spacing="10" GridPane.columnIndex="1" styleClass="new-book-section">
            <VBox spacing="5">
                <Label text="Couverture" styleClass="form-label"/>
                <StackPane styleClass="cover-drop-zone">
                    <VBox spacing="8" alignment="CENTER">
                        <Label text="Glisser-déposer la couverture" styleClass="cover-drop-title"/>
                        <Button text="Parcourir" styleClass="manage-rayon-btn"/>
                    </VBox>
                </StackPane>
            </VBox>

            <VBox spacing="5">
                <Label text="Catégorie" styleClass="form-label"/>
                <ComboBox fx:id="categoryCombo" promptText="Sélectionner une catégorie" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Localisation (Rayon)" styleClass="form-label"/>
                <ComboBox fx:id="rayonCombo" promptText="Sélectionner un rayon" maxWidth="Infinity" styleClass="form-combo"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Quantité en stock" styleClass="form-label"/>
                <Spinner fx:id="stockSpinner" maxWidth="Infinity" styleClass="form-spinner"/>
            </VBox>
        </VBox>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="new-book-actions">
        <Button text="Annuler" onAction="#onCancel" styleClass="cancel-btn"/>
        <Button text="Enregistrer le livre" onAction="#onSaveBook" styleClass="books-primary-btn"/>
    </HBox>
</VBox>
